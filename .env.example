# Kopieren nach .env und anpassen. Wird von ./run-local.sh gelesen.

# ---------- Telemetrie: genau eine Betriebsart aktiv lassen ----------

# Ohne Telemetrie (Standard): Agent instrumentiert, exportiert aber nichts – kein Backend nötig, keine Fehler-Logs
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Lokal: SigNoz oder Collector auf demselben Rechner (OTLP gRPC)
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Bereitgestellt: gehostetes SigNoz (z. B. im Workshop) mit Zugangsdaten
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>
# 20 Ticks/s = 20 Traces/s – für gehostete Ziele Sampling empfohlen:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

OTEL_METRIC_EXPORT_INTERVAL=10000

# ---------- Spiel ----------
GAME_PORT=8088
GAME_BOTS=3
GAME_ENEMIES=2
GAME_LLM_ENABLED=false
SWARM_PLAYERS=10

# Speicher pro JVM
JAVA_OPTS=-Xmx256m

# ---------- Gegner-KI mit LLM (nur wenn im Admin-Panel eingeschaltet) ----------
# OpenAI-kompatibler Endpunkt, typischerweise LiteLLM (deploy/litellm-config.yaml)
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_MODEL=enemy-brain
# LLM_API_KEY=sk-local
