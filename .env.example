# Kopieren nach .env und anpassen. Gilt für ./run-local.sh (ohne Docker) und docker compose.

# ---------- Telemetrie: genau eine Betriebsart aktiv lassen ----------

# Ohne Telemetrie (Standard): Agent instrumentiert, exportiert aber nichts – kein Backend nötig, keine Warn-Logs
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Lokal: SigNoz oder Collector auf dem eigenen Rechner (OTLP gRPC).
# Aus docker compose heraus heißt der Host host.docker.internal statt localhost.
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Bereitgestellt: gehostetes SigNoz (z. B. im Workshop) mit Zugangsdaten
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>
# 20 Ticks/s = 20 Traces/s – für gehostete Ziele Sampling empfohlen:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

OTEL_METRIC_EXPORT_INTERVAL=10000

# ---------- Spiel ----------
GAME_PORT=8088
GAME_BOTS=3
GAME_ENEMIES=2
GAME_LLM_ENABLED=false
SWARM_PLAYERS=10

# Nur ./run-local.sh: Speicher pro JVM
JAVA_OPTS=-Xmx256m

# ---------- Docker-Compose-Profil "llm" ----------
OLLAMA_MODEL=qwen2.5:3b
LLM_MODEL=enemy-brain
# ANTHROPIC_API_KEY=sk-ant-...
